rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: user email is in the allowedEmails whitelist
    function isAllowedUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email));
    }

    // Helper: user is authenticated and member of the family
    function isFamilyMember(familyId) {
      return isAllowedUser()
        && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members;
    }

    // Users can only read their own allowedEmails document (to check access)
    match /allowedEmails/{email} {
      allow read: if request.auth != null
        && request.auth.token.email == email;
      allow write: if false;
    }

    // Helper: validate event base fields
    function hasValidBaseFields() {
      let data = request.resource.data;
      return data.babyId is string
        && data.type in ['feeding', 'pee', 'poop', 'medication', 'bath', 'meal']
        && data.timestamp is timestamp
        && data.createdBy == request.auth.uid
        && data.createdAt is timestamp
        // Reject timestamps more than 48h in the future
        && data.timestamp <= request.time + duration.value(48, 'h')
        // Notes: optional, max 500 chars
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    // Helper: validate feeding-specific fields
    function hasValidFeedingFields() {
      let data = request.resource.data;
      return data.type == 'feeding'
        && data.feedingType in ['breast', 'bottle']
        && (!('leftCount' in data) || (data.leftCount is int && data.leftCount >= 0))
        && (!('rightCount' in data) || (data.rightCount is int && data.rightCount >= 0))
        && (!('durationMinutes' in data)
          || (data.durationMinutes is int && data.durationMinutes > 0 && data.durationMinutes <= 300))
        && (!('infection' in data) || data.infection is bool)
        && (!('engorgement' in data) || data.engorgement is bool);
    }

    // Helper: validate medication-specific fields
    function hasValidMedicationFields() {
      let data = request.resource.data;
      return data.type == 'medication'
        && data.medicationName is string
        && data.medicationName.size() > 0
        && data.medicationName.size() <= 200
        && data.dose is string
        && data.dose.size() > 0
        && data.dose.size() <= 200;
    }

    // Helper: validate meal-specific fields
    // NOTE: the rules language cannot iterate lists, so per-item validation of
    // `items` (foodId, quantity, unit, etc.) is client-side only. This is not
    // fixable without Cloud Functions (Blaze plan, out of scope). We only
    // validate that `items` is a list of a sane size here.
    function hasValidMealFields() {
      let data = request.resource.data;
      return data.type == 'meal'
        && data.mealSlot in ['breakfast', 'lunch', 'dinner', 'snack']
        && data.items is list
        && data.items.size() >= 1
        && data.items.size() <= 12
        && (!('reaction' in data) || data.reaction is map);
    }

    // Helper: validate measurement value bounds by type
    function hasValidMeasurementValue() {
      let data = request.resource.data;
      return (data.type == 'weight' && data.value > 0 && data.value <= 30)
        || (data.type == 'height' && data.value > 0 && data.value <= 150)
        || (data.type == 'head' && data.value > 0 && data.value <= 65);
    }

    // Helper: validate measurement fields
    function isValidMeasurement() {
      let data = request.resource.data;
      return data.babyId is string
        && data.type in ['weight', 'height', 'head']
        && data.value is number
        && hasValidMeasurementValue()
        && data.date is timestamp
        && data.createdBy == request.auth.uid
        && data.createdAt is timestamp
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    // Helper: validate measurement update
    function isValidMeasurementUpdate() {
      let data = request.resource.data;
      let prev = resource.data;
      return data.babyId == prev.babyId
        && data.type == prev.type
        && data.createdBy == prev.createdBy
        && data.createdAt == prev.createdAt
        && data.value is number
        && hasValidMeasurementValue()
        && data.date is timestamp
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    // Helper: validate food fields (foods subcollection)
    function isValidFood() {
      let data = request.resource.data;
      return !('id' in data)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && data.group in ['grain', 'vegetable', 'fruit', 'protein', 'dairy', 'fat', 'other']
        && data.allergens is list
        && data.gramsPerTsp is number
        && data.gramsPerTsp > 0
        && data.gramsPerTsp <= 15
        && data.minStage in [1, 2, 3, 4]
        && data.status in ['untried', 'safe', 'watch', 'suspected', 'confirmed_allergy', 'avoid']
        && data.usageCount is int
        && data.usageCount >= 0
        && data.exposureCount is int
        && data.exposureCount >= 0
        && data.reactionEventIds is list
        && data.nutrientSource in ['seed', 'manual']
        && (!('statusUpdatedAt' in data) || data.statusUpdatedAt is timestamp)
        && (!('firstTriedAt' in data) || data.firstTriedAt is timestamp)
        && (!('lastTriedAt' in data) || data.lastTriedAt is timestamp)
        && (!('nutrients' in data) || data.nutrients is map)
        && (!('sourceRef' in data) || (data.sourceRef is string && data.sourceRef.size() <= 200));
    }

    // Helper: validate event by type
    function isValidEvent() {
      let data = request.resource.data;
      return hasValidBaseFields()
        && (
          (data.type == 'feeding' && hasValidFeedingFields())
          || (data.type == 'pee')
          || (data.type == 'poop')
          || (data.type == 'medication' && hasValidMedicationFields())
          || (data.type == 'bath')
          || (data.type == 'meal' && hasValidMealFields())
        );
    }

    // Helper: validate event update — prevent changing immutable fields AND re-validate mutable fields
    function isValidEventUpdate() {
      let data = request.resource.data;
      let prev = resource.data;
      // Immutable fields must not change
      let immutableOk = data.babyId == prev.babyId
        && data.type == prev.type
        && data.createdBy == prev.createdBy
        && data.createdAt == prev.createdAt;
      // Timestamp must be valid
      let timestampOk = data.timestamp is timestamp
        && data.timestamp <= request.time + duration.value(48, 'h');
      // Notes must still be valid if present
      let notesOk = (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
      // Type-specific mutable fields must be valid
      let typeFieldsOk = (
        (data.type == 'feeding' && hasValidFeedingFields())
        || (data.type == 'pee')
        || (data.type == 'poop')
        || (data.type == 'medication' && hasValidMedicationFields())
        || (data.type == 'bath')
        || (data.type == 'meal' && hasValidMealFields())
      );
      return immutableOk && timestampOk && notesOk && typeFieldsOk;
    }

    // Families
    match /families/{familyId} {
      allow read: if isAllowedUser()
        && request.auth.uid in resource.data.members;

      // CRITICAL: members array MUST contain ONLY the creator on creation.
      // This prevents a user from adding arbitrary UIDs to gain access to other users' data.
      allow create: if isAllowedUser()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0] == request.auth.uid;

      // Update: only family members, and cannot remove themselves (prevent orphan families)
      allow update: if isFamilyMember(familyId)
        && request.auth.uid in request.resource.data.members;

      allow delete: if false;

      // Babies
      match /babies/{babyId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.firstName is string
          && request.resource.data.firstName.size() > 0
          && request.resource.data.firstName.size() <= 100
          && request.resource.data.birthDate is timestamp
          && (!('sex' in request.resource.data) || request.resource.data.sex in ['male', 'female']);
        allow update: if isFamilyMember(familyId)
          && request.resource.data.firstName is string
          && request.resource.data.firstName.size() > 0
          && request.resource.data.firstName.size() <= 100
          && (!('sex' in request.resource.data) || request.resource.data.sex in ['male', 'female']);
        allow delete: if false;
      }

      // Events
      match /events/{eventId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId) && isValidEvent();
        allow update: if isFamilyMember(familyId) && isValidEventUpdate();
        allow delete: if isFamilyMember(familyId);
      }

      // Measurements (weight, height, head circumference)
      match /measurements/{measurementId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId) && isValidMeasurement();
        allow update: if isFamilyMember(familyId) && isValidMeasurementUpdate();
        allow delete: if isFamilyMember(familyId);
      }

      // Foods (per-family food catalog: usage/exposure/status tracking)
      match /foods/{foodId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId) && isValidFood();
        // exposureCount must not decrease. This clause is load-bearing twice:
        //  1. the delete guard below only holds if a food can't be zeroed out
        //     via update just to unlock a delete;
        //  2. it is the only thing stopping upsertFood's setDoc(merge: true)
        //     from wiping an established food's status and reactionEventIds.
        //     minimalFood() and foodFromSeed() always write exposureCount: 0,
        //     so any such merge onto an eaten food is rejected here.
        // If anyone ever makes upsertFood preserve the existing counters, that
        // second protection silently disappears with it — a re-upsert would
        // then quietly reset a confirmed_allergy back to untried.
        // (The app only ever increments this counter — no decrement exists.)
        //
        // A confirmed_allergy/avoid status is a human's manual call, but every
        // client works from a snapshot: a derived write (applyReaction,
        // withdrawReaction) computed on a stale snapshot can't tell the food
        // is manually locked, and would blindly overwrite the server's real
        // status. Since a derived write always carries the mealId it's acting
        // on in reactionEventIds, requiring an empty reactionEventIds to
        // change a locked status blocks that clobber while still allowing the
        // one write that legitimately changes it: a human's manual
        // reassignment from FoodPage, which always clears reactionEventIds
        // (see setAllergenStatus).
        allow update: if isFamilyMember(familyId) && isValidFood()
          && request.resource.data.exposureCount >= resource.data.exposureCount
          && (
            !(resource.data.status in ['confirmed_allergy', 'avoid'])
            || request.resource.data.status == resource.data.status
            || request.resource.data.reactionEventIds.size() == 0
          );
        // A food the baby has actually eaten is history and must not vanish.
        allow delete: if isFamilyMember(familyId)
          && resource.data.exposureCount == 0;
      }
    }
  }
}
